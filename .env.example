# Porta pública na VPS (mude se conflitar com o Hermes)
PORT=8090
# Senha para abrir o app no celular
APP_PASSWORD=troque-esta-senha
# Destino no Google Drive (configurado pelo rclone). Vazio = só salva na VPS
RCLONE_REMOTE=gdrive:B-Rolls
# 1 = mantém cópia na VPS (necessário para a galeria tocar os vídeos)
KEEP_LOCAL=1
# Vídeos processados em paralelo (2 é bom para VPS de 2-4 núcleos)
WORKERS=2

# --- Curadoria ---
CLIP_MIN=3
CLIP_MAX=8
MAX_SOURCE_MINUTES=15
MIN_HEIGHT=720
MAX_HEIGHT=2160
MAX_CLIPS_PER_SOURCE=6
# Gera cópia vertical 9:16 de cada clipe horizontal
VERTICAL_COPY=1
# IA de visão local (CLIP). 0 = desliga (mais rápido, menos preciso)
VISION=1
# Relevância mínima ao tema (0.18 mais solto ... 0.28 mais rígido)
MIN_RELEVANCE=0.22
# Rejeição de "pessoa falando/slide/logo/texto" (menor = mais rígido)
NEG_LIMIT=0.35
